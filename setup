#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES_DIR

source "${DOTFILES_DIR}/helper/log.sh"

MODE=""
RUN_PACKAGES=true
RUN_LINKS=true
DRY_RUN=false

usage() {
    cat <<EOF_USAGE
Usage: $0 [home|work] [options]

Modes:
  home            Personal configs (zshrc, Brewfile, aerospace.toml)
  work            Work configs from private/ (must be populated first)

Options:
  --pkgs-only     Only install/update packages (skip symlinks)
  --links-only    Only apply symlinks and git config (skip packages)
  --dry-run       Show what would be done without making changes
  -h, -help, --help
                  Show this help and exit
EOF_USAGE
}

for arg in "$@"; do
    case "$arg" in
        home|work) MODE="$arg" ;;
        -h|-help|--help) usage; exit 0 ;;
        --pkgs-only) RUN_LINKS=false ;;
        --links-only) RUN_PACKAGES=false ;;
        --dry-run) DRY_RUN=true ;;
        *) printf "Unknown argument: %s\n\n" "$arg" >&2; usage >&2; exit 1 ;;
    esac
done

if [[ -z "$MODE" ]]; then
    usage >&2
    exit 1
fi

export DRY_RUN

export MODE
OS="$(uname -s)"

IS_ARCH=false
if [[ "$OS" == "Linux" && -f /etc/os-release ]]; then
    OS_ID="$(. /etc/os-release && echo "${ID:-}")"
    OS_ID_LIKE="$(. /etc/os-release && echo "${ID_LIKE:-}")"
    if [[ "$OS_ID" == "arch" || "$OS_ID_LIKE" == *"arch"* ]]; then
        IS_ARCH=true
    fi
fi
export IS_ARCH

log_info "Detected OS: $OS${OS_ID:+ ($OS_ID)}"

if [[ "$RUN_PACKAGES" == true ]]; then
    if [[ "$DRY_RUN" == true ]]; then
        log_info "Dry run: skipping package installation (would install packages for $OS)"
    else
        case "$OS" in
            Darwin) source "${DOTFILES_DIR}/scripts/packages-macos.sh" ;;
            Linux)
                if [[ "$IS_ARCH" == true ]]; then
                    source "${DOTFILES_DIR}/scripts/packages-arch.sh"
                else
                    source "${DOTFILES_DIR}/scripts/packages-linux.sh"
                fi
                ;;
            *)      printf "Unsupported OS: %s\n" "$OS"; exit 1 ;;
        esac
    fi
fi

if [[ "$RUN_LINKS" == true ]]; then
    source "${DOTFILES_DIR}/scripts/links.sh"
fi
