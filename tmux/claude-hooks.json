{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|fork", "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh idle", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh working", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh tool", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh blocked", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh working", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh tool-failure", "timeout": 5 }] }
    ],
    "Notification": [
      { "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog", "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh blocked", "timeout": 5 }] },
      { "matcher": "idle_prompt", "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh idle-if-busy", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh done", "timeout": 5 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh done", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "$HOME/.dotfiles/tmux/scripts/agent-state.sh clear", "timeout": 5 }] }
    ]
  }
}
